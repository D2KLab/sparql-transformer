    "license": "Apache-2.0",
    "devDependencies": {
        "eslint": "^8.34.0",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-plugin-import": "^2.27.5",
        "esm": "^3.2.25",
        "rollup": "^3.17.2",
        "rollup-plugin-cleanup": "^3.2.1"
    },
    "dependencies": {
        "fast-deep-equal": "^3.1.3",
        "jsonfile": "^6.1.0",
        "object-assign-deep": "^0.4.0"
    }
