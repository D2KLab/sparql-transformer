{
    "name": "sparql-transformer",
    "version": "3.1.2",
    "description": "Transform the SPARQL Endpoint output in JSON or JSON-LD",
    "main": "src/node_main.mjs",
    "type": "module",
    "module": "src/main.mjs",
    "browser": "dist/browser.mjs",
    "engines": {
        "node": ">=24.0.0"
    },
    "files": [
        "**/*.mjs",
        "*.js"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/D2KLab/sparql-transformer.git"
    },
    "scripts": {
        "test": "DEBUG_LEVEL=debug node --test test.js",
        "lint": "eslint .",
        "prepublishOnly": "rollup -c",
        "postpublish": "git push --follow-tags"
    },
    "keywords": [
        "json-ld",
        "sparql",
        "converter"
    ],
    "author": "Pasquale Lisena <pasquale.lisena@eurecom.fr> (http://pasqlisena.github.io/)",
    "license": "Apache-2.0",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.12.0",
        "eslint-plugin-import-x": "^4.17.1",
        "globals": "^17.13.0",
        "rollup": "^4.64.6",
        "rollup-plugin-cleanup": "^3.2.1"
    },
    "dependencies": {
        "fast-deep-equal": "^3.1.3",
        "object-assign-deep": "^0.4.0"
    }
}
